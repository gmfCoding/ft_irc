{
	"version": "0.2.0",
	"configurations": [
		{
            "name": "Launch: Build and Run program",
            "type": "cppdbg",
            "request": "launch",
            "stopAtEntry": false,
            "cwd": "${workspaceRoot}/",
            "externalConsole": false,
            "MIMode": "lldb",
			"miDebuggerPath": "/usr/bin/lldb",
			"args": ["6667", "123"],
			"program": "${workspaceFolder}/ircserv",
            "preLaunchTask": "Build Debug"
		},
		{
			"type": "lldb",
			"request": "attach",
			"name": "LLDB Attach",
			"program": "${workspaceFolder}/ircserv"
		},
		{
			"type": "lldb",
			"request": "launch",
			"name": "LLDB Launch",
			"program": "${workspaceFolder}/ircserv",
			"args": ["6667", "123"],
			"cwd": "${workspaceFolder}",
		}
	]
}